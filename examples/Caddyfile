# Caddy in front of Sentinel (docs/deployment.md#tls-and-a-reverse-proxy).
# Caddy obtains and renews the certificate for the name itself (ports 80 and
# 443 must reach it). The controller's public_url is https://ci.example.com;
# sentinel-web runs with SENTINEL_CLIENT_IP_HEADER=x-forwarded-for.
#
# Without the web interface, point reverse_proxy at the controller's
# api_listen (127.0.0.1:7080) and send only the routes listed in the guide.
ci.example.com {
	encode zstd gzip

	# The GitHub webhook's 4 MiB is the largest body the controller accepts.
	request_body {
		max_size 4MB
	}

	header Strict-Transport-Security "max-age=31536000"

	reverse_proxy 127.0.0.1:3000 {
		# Overwrite, never append: a client's own X-Forwarded-For must not
		# reach the controller.
		header_up X-Forwarded-For {remote_host}
		# Log following and event streams are long-lived and unbuffered.
		flush_interval -1
		transport http {
			response_header_timeout 1h
		}
	}
}
