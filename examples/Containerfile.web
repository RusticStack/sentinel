# The web interface (`sentinel-web`, docs/web-ui.md) as an image: a two-stage
# build, so the runtime image holds the built `.output` and Node, not the
# toolchain or the sources.
#
# The release packages carry no web sources, so the build context is the
# repository's `web/` directory at the release tag, not an unpacked package:
#
#   git clone --branch v<version> <repository> && cd sentinel
#   podman build --format docker -f examples/Containerfile.web -t localhost/sentinel-web:<version> web/
#
# `pnpm install --frozen-lockfile` is what ties the dependencies to the tag
# (pnpm-lock.yaml). NODE is an exact tag; pin its digest (`NODE=...@sha256:...`)
# once resolved on the build host. PNPM is the version in web/package.json's
# `packageManager`. See docs/deployment.md#container-examples.
ARG NODE=docker.io/library/node:22.22.1-slim
ARG PNPM=12.15.0

FROM ${NODE} AS build
ARG PNPM
RUN npm install --global pnpm@${PNPM}
WORKDIR /src
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY tsconfig.json tsr.config.json vite.config.ts ./
COPY src ./src
RUN pnpm exec tsr generate && pnpm build

FROM ${NODE}
RUN groupadd --system --gid 10003 sentinel-web \
 && useradd --no-create-home --uid 10003 --gid sentinel-web --home-dir /nonexistent \
      --shell /usr/sbin/nologin sentinel-web
# Root-owned and read-only to the service: the process cannot rewrite its code.
COPY --from=build --chown=0:0 /src/.output /opt/sentinel/web/.output
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
USER sentinel-web
WORKDIR /opt/sentinel/web
# The controller's api_listen is SENTINEL_API (compose.server.yaml sets it). The
# host decides who can connect: publish on 127.0.0.1, behind the reverse proxy.
EXPOSE 3000
STOPSIGNAL SIGTERM
# Through the web process to the controller's health route, so it reports
# unhealthy while the controller is unreachable. Node is the only tool here.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["/usr/local/bin/node", "-e", "fetch('http://127.0.0.1:'+process.env.PORT+'/api/v1/health',{signal:AbortSignal.timeout(4000)}).then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
ENTRYPOINT ["/usr/local/bin/node", "/opt/sentinel/web/.output/server/index.mjs"]
