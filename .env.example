GITHUB_CLIENT_ID=your_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_oauth_app_client_secret
# ≥32 random characters (HMAC for OAuth handshake + session-id hashing)
SESSION_SECRET=generate_a_random_32_char_string_here
# Deno KV session DB path (default data/sessions.db; use :memory: only in tests)
# SESSION_DB_PATH=data/sessions.db
GH_ORG=your_org_name
# Classic PAT with admin:org + repo (membership re-checks + org runner/run queries)
GITHUB_PAT=ghp_your_pat_with_admin_org_and_repo
# Public origin for OAuth redirect_uri + Secure cookies (REQUIRED off localhost)
APP_BASE_URL=https://sentinel.example.com
# Production listen port for systemd (deploy/sentinel.service → deno serve --port=${PORT}).
# Does not change Vite dev (vite.config.ts → 8000). `deno task start` hardcodes 3000.
PORT=3000
RUNNER_COUNT=4

# Optional: Vigil SOC integration
# Set VIGIL_URL to enable the security tab in the UI
# Vigil findings/cases/agents require a Vigil user JWT (service account login)
VIGIL_URL=http://localhost:6987
VIGIL_USERNAME=sentinel_service_user
VIGIL_PASSWORD=your_vigil_password
