# Copy to .env (git-ignored) and fill in. The verification VPS every test runs on
# (AGENTS.md, docs/development.md#where-tests-run).
SENTINEL_VPS_HOST=
SENTINEL_VPS_USER=root
# Key-based SSH only; the host refuses passwords.
SENTINEL_VPS_KEY=~/.ssh/id_ed25519

# Optional: email delivery of verification and invitation links through Resend
# (https://resend.com), read by the CONTROLLER at start
# (docs/configuration.md#email-delivery). They override the [mail] section key
# by key. Without both, nothing is sent and the operator mints links with
# `sentinel admin account email-link`. Needs `public_url` in the controller
# configuration and a master key (`sentinel admin key create`). The API key
# lives in an owner-only file holding just the key (mode 0600, not a link),
# never in an environment variable; the sender's domain must be verified in
# Resend.
# SENTINEL_RESEND_API_KEY_FILE=/etc/sentinel/resend-key
# SENTINEL_EMAIL_FROM=Sentinel <sentinel@example.com>

# First-run setup needs no variable: while no administrator exists the
# controller prints a one-time setup token on the host console and writes it to
# <data_dir>/setup-token (0600); the web wizard asks for it
# (docs/development.md#operator-first-run). `sentinel admin bootstrap` stays an
# equivalent shell path. The token is never read from the environment.

# Optional: email-domain auto-join, read by the CONTROLLER at start
# (docs/configuration.md#domain-auto-join). Entries are `domain=organization`
# or a bare `domain` (an organization named after it: example.org is
# example-org), separated by commas or spaces. A person whose VERIFIED address is
# in exactly that domain joins the app-created organization as a reader; the
# first match for an organization that does not exist yet creates it and
# administers it. Exact match only (no subdomains, no suffixes); never applies to
# GitHub-backed organizations. A malformed entry is skipped with a startup warning.
# SENTINEL_AUTO_JOIN_DOMAINS=rusticstack.com=rustic,example.org
