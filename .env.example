# Optional maintainer verification hosts. Copy to .env (git-ignored) and fill in.
# Use key-based SSH and unprivileged verification accounts. Never commit real values.
# x86_64 KVM host: default verification and multi-host controller.
SENTINEL_MAIN_HOST=
SENTINEL_MAIN_USER=
# x86_64 reference host for same-hardware benchmarks.
SENTINEL_VPS_HOST=
SENTINEL_VPS_USER=
# arm64 rootless-Podman worker host.
SENTINEL_ARM_HOST=
SENTINEL_ARM_USER=
SENTINEL_VPS_KEY=
# Stable anonymized labels written into benchmark records; never machine or account names.
SENTINEL_BENCH_HOST_LABEL=
SENTINEL_BENCH_USER_LABEL=

# Optional Resend email delivery, read by the controller at start. The key file holds only the key (mode 0600).
# SENTINEL_RESEND_API_KEY_FILE=/etc/sentinel/resend-key
# SENTINEL_EMAIL_FROM=Sentinel <sentinel@example.com>

# First-run setup token: never read from the environment; the controller prints it and writes <data_dir>/setup-token.

# Optional email-domain auto-join, read by the controller at start. Entries are `domain=organization` or a bare `domain`, comma- or space-separated; exact matches on VERIFIED addresses only.
# SENTINEL_AUTO_JOIN_DOMAINS=example.com=engineering,example.org
