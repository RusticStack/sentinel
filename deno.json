{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check main.ts utils.ts client.ts vite.config.ts routes/ components/ lib/",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A --port=${PORT:-3000} _fresh/server.js",
    "test": "deno test -A",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "exclude": [
    "**/_fresh/*",
    "**/_scaffold_tmp/*"
  ],
  "fmt": {
    "exclude": [
      "**/*.md",
      "**/_fresh/*",
      "**/_scaffold_tmp/*"
    ]
  },
  "lint": {
    "exclude": [
      "**/_fresh/*",
      "**/_scaffold_tmp/*"
    ],
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "imports": {
    "@/": "./",
    "@fontsource/ibm-plex-mono": "npm:@fontsource/ibm-plex-mono@^5.3.0",
    "@fontsource/ibm-plex-sans": "npm:@fontsource/ibm-plex-sans@^5.3.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@tailwindcss/node": "npm:@tailwindcss/node@^4.3.3",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "lucide-preact": "npm:lucide-preact@^1.25.0",
    "preact": "npm:preact@^10.29.7",
    "@preact/signals": "npm:@preact/signals@^2.9.4",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.3.6",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
