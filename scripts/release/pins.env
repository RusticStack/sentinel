# Pinned third-party binaries the release carries or names (docs/releasing.md#bundled-binaries).
# Plain KEY=value lines: sourced by scripts/release/package.sh and read by verify-manifest.py.
# A pin changes only with a person checking the new digest against the publisher's own checksum.

# Firecracker v1.17.0, Apache-2.0, packaged in the x86_64 worker. *_TGZ_SHA256 is the release
# archive's checksum as published beside it (firecracker-v1.17.0-x86_64.tgz.sha256.txt);
# *_SHA256 is the firecracker executable inside it.
FIRECRACKER_VERSION=v1.17.0
FIRECRACKER_X86_64_TGZ_SHA256=06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558
FIRECRACKER_X86_64_SHA256=99ad0f5cd0514a88aad0e9ae8cfdb3cc3b4ab9d190e1194602406c786b5de7a5

# Guest kernel built by bench/microvm/build-kernel.sh, GPL-2.0-only, packaged in the x86_64 worker.
# KERNEL_SHA256 is the vmlinux it prints and KERNEL_CONFIG_SHA256 the .config it writes.
KERNEL_VERSION=6.18.52
KERNEL_SHA256=71ddb78cc80f4aa9db7a8e5d42349224d09acc581a0c56269aecd5ea9e3a8de6
KERNEL_CONFIG_SHA256=8115c96ba7dd46255e312475845e503f8c3fbb828de256e725b85f44281c47c7

# Tailcat v0.6.0, BSD-3-Clause, installed by the generated enrollment script (Q11), not packaged.
# *_TGZ_SHA256 is the upstream archive (checked against its checksums.txt); *_SHA256 the executable.
TAILCAT_VERSION=v0.6.0
TAILCAT_X86_64_TGZ_SHA256=f3597a9ad02f5cca538f8f5a6f89123910bce3e9611d1e5a8e96d5f2d3cc90fd
