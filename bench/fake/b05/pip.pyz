#!/usr/bin/env python3
"""Stub of pip for the B05 smoke profile: download, install and freeze create files and fail like pip --no-index does
when the wheelhouse is empty. FAKE_LOG records every call; FAKE_FAIL=pip makes it fail."""
import os
import sys

args = sys.argv[1:]
if os.environ.get("FAKE_LOG"):
    with open(os.environ["FAKE_LOG"], "a") as f:
        f.write("pip " + " ".join(args) + "\n")
if os.environ.get("FAKE_FAIL") == "pip":
    sys.exit("pip: failing on request (FAKE_FAIL)")


def opt(name):
    return args[args.index(name) + 1] if name in args else None


def populate(path, n=3):
    os.makedirs(path, exist_ok=True)
    for i in range(n):
        with open(os.path.join(path, f"w{i}.whl"), "w") as f:
            f.write("fake\n")


cmd = args[0] if args else ""
if cmd == "download":
    populate(opt("-d"))
elif cmd == "install":
    if "--no-index" in args:
        wh = opt("--find-links")
        if not wh or not os.path.isdir(wh) or not os.listdir(wh):
            sys.exit("pip: no matching distribution: --no-index and the wheelhouse is empty")
    target = opt("--target")
    os.makedirs(target, exist_ok=True)
    for mod in ("numpy", "pandas", "scipy", "requests"):
        with open(os.path.join(target, mod + ".py"), "w") as f:
            f.write("# fake\n")
elif cmd == "freeze":
    print("numpy==0.0.0\npandas==0.0.0\nscipy==0.0.0\nrequests==0.0.0")
else:
    sys.exit(f"pip: unknown command {cmd!r}")
