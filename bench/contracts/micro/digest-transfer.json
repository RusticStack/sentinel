{
  "format": "sentinel.bench-micro-contract/1",
  "id": "digest-transfer",
  "revision": 1,
  "harness": {
    "example": "digest-transfer-bench",
    "build": "cargo build --release --locked -p sentinel-worker --example digest-transfer-bench"
  },
  "run": {
    "args": ["--files", "48", "--file-bytes", "262144", "--rounds", "5"],
    "smoke_args": ["--files", "6", "--file-bytes", "16384", "--rounds", "1"]
  },
  "ordering": {
    "scheme": "abba",
    "seed": null
  },
  "quiet_start": {
    "max_cpu_pressure_avg60": 5.0
  },
  "record": {
    "schema": "sentinel-bench/digest-transfer/1",
    "out": "bench/digest-transfer.jsonl"
  },
  "notes": "ABBA per round: the bodies sample comes first on odd rounds and last on even ones, so the order is fixed and no seed is drawn. The bench keeps its own temporary store and workspace, so it measures no DIR file system."
}
