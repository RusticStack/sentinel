{
  "format": "sentinel.bench-micro-contract/1",
  "id": "checks-lane",
  "revision": 1,
  "harness": {
    "example": "checks-lane-bench",
    "build": "cargo build --release --locked -p sentinel-checks --example checks-lane-bench"
  },
  "run": {
    "args": ["--runs", "16", "--rounds", "5", "--bursts", "1,8"],
    "smoke_args": ["--runs", "4", "--rounds", "2", "--bursts", "1,8"],
    "dir": true
  },
  "ordering": {
    "scheme": "abba",
    "seed": null
  },
  "quiet_start": {
    "max_cpu_pressure_avg60": 5.0
  },
  "record": {
    "schema": "sentinel-bench/checks-lane/1",
    "out": "bench/checks-lane.jsonl"
  },
  "notes": "Burst sizes reverse every round (ABBA); the fake GitHub endpoint is in the example, so a smoke run needs nothing external."
}
